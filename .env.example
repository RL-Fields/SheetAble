# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`.

# Postgres credentials (used by both the "db" and "backend" services)
DB_USER=sheetable
DB_PASSWORD=change-me-to-something-random
DB_NAME=sheetable

# Used to sign login JWTs - set this to a long random string
API_SECRET=change-me-to-something-random

# First admin account, created on first boot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public URL you'll reach SheetAble at (through Nginx Proxy Manager etc.)
SERVER_URL=http://sheetable.home

# Host port to publish the app on. Defaults to 8081 (not 8080) so this can
# run alongside an existing/unforked SheetAble instance without a port
# clash. Change once you've retired the old instance, if you want.
HOST_PORT=8081
